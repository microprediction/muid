{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "tap",
  "tap": {
    "testFiles": [
      "tests/membership/*.test.mjs"
    ]
  },
  "mutate": [
    "src/membership.js"
  ],
  "coverageAnalysis": "perTest",
  "thresholds": {
    "high": 100,
    "low": 95,
    "break": 95
  },
  "reporters": [
    "clear-text",
    "progress",
    "json"
  ],
  "jsonReporter": {
    "fileName": "reports/mutation/membership.json"
  },
  "tempDirName": ".stryker-tmp",
  "concurrency": 4,
  "timeoutMS": 120000
}
