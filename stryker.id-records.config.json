{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "tap",
  "tap": {
    "testFiles": [
      "tests/id/P1-records.test.mjs",
      "tests/id/P3-html.test.mjs",
      "tests/id/P2-page.test.mjs"
    ]
  },
  "mutate": [
    "id/records.js"
  ],
  "coverageAnalysis": "off",
  "thresholds": {
    "high": 100,
    "low": 95,
    "break": 95
  },
  "reporters": [
    "clear-text",
    "progress",
    "json"
  ],
  "jsonReporter": {
    "fileName": "reports/mutation/id-records.json"
  },
  "tempDirName": ".stryker-tmp",
  "concurrency": 4
}
